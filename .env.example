# Copy this file to .env and replace this placeholder with a random hex password.
# Never commit .env. The Compose stack is a local demonstration, not deployment config.
POSTGRES_PASSWORD=replace-with-a-random-hex-password
POSTGRES_PORT=5432
API_PORT=8080

# Optional. Core incident management and all automated tests work without an API key.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
